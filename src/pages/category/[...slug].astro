---
import { getCategory, getEditableCategory, getEditableGlobalChrome, getGlobalChrome, listBlogs, listCategories } from '../../lib/data';
import { referenceSlug, renderAuthority } from '../../lib/demo-authority';
import { mutateCategory } from '../../lib/commercial-renderers';

export const prerender = false;
const parts = String(Astro.params.slug || '').toLowerCase().split('/').filter(Boolean);
const pageIndex = parts.indexOf('page');
const slug = (pageIndex >= 0 ? parts.slice(0, pageIndex) : parts).join('/');
const page = pageIndex >= 0 ? Math.max(1, Number(parts[pageIndex + 1]) || 1) : 1;
const perPage = 7;
const categories = await listCategories();
const categoryEntry: any = categories.find((item: any) => referenceSlug(item) === slug || referenceSlug(item?._sys?.filename) === slug);
if (!categoryEntry) return new Response('Not Found', { status: 404 });
const documentSlug = categoryEntry?._sys?.filename || slug;
const editing = Boolean(Astro.locals.tinaEdit);
const category: any = (await (editing ? getEditableCategory(documentSlug) : getCategory(documentSlug))).data?.category || categoryEntry;
// The supplied category authority is a seven-story newsroom ledger. Preserve
// its card count and ordering and inject the current Tina newsroom feed into
// those immutable wrappers; the category document still owns the archive
// identity, title, SEO, and editable description.
const allPosts = await listBlogs();
const posts = allPosts.slice((page - 1) * perPage, page * perPage);
const chrome = await (editing ? getEditableGlobalChrome() : getGlobalChrome());
const config: any = chrome.config;
const seo = category.seo || {};
const canonical = page > 1 ? `/category/${slug}/page/${page}/` : `/category/${slug}/`;
return renderAuthority({
  family: 'category',
  chrome,
  seo: {
    title: seo.metaTitle || `${category.title} Articles | ${config?.seo?.title || 'Commercial Daily News'}`,
    description: seo.metaDescription || category.description || '',
    canonical: seo.canonicalUrl || canonical,
    image: seo.ogImage || posts[0]?.heroImage,
    ogTitle: seo.ogTitle,
    ogDescription: seo.ogDescription,
    noindex: seo.noindex,
    nofollow: seo.nofollow,
  },
  mutate: ($) => mutateCategory($, category, posts, page, allPosts.length, perPage),
});
---
