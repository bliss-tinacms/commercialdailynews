---
import { getGlobalChrome, listBlogs, listPages } from '../lib/data';
import { getBlogPermalink, getPageRouteSlug } from '../lib/permalinks';
import { mutateGenericPage } from '../lib/commercial-renderers';
import { renderAuthority } from '../lib/demo-authority';
import { buildSitemapSections } from '../lib/sitemap-entries.mjs';

export const prerender = false;
const [pages, posts, chrome] = await Promise.all([listPages(), listBlogs(), getGlobalChrome()]);
const sections = buildSitemapSections({
  pages,
  posts,
  pageHref: (page: any) => page?._sys?.filename === 'home' ? '/' : getPageRouteSlug(page),
  postHref: (post: any) => getBlogPermalink(post),
});
const lines: string[] = [];
for (const section of sections) {
  lines.push(`## ${section.heading}`, '', ...section.items.map((item: any) => `- [${item.title}](${item.href})`), '');
}
const title = 'Sitemap';
const description = 'Browse public webpages and posts published by Commercial Daily News.';
return renderAuthority({
  family: 'page',
  chrome,
  seo: { title: `${title} | Commercial Daily News`, description, canonical: '/sitemap/' },
  mutate: ($) => {
    mutateGenericPage($, { title, demoHeadline: title, body: lines.join('\n'), replaceAllContent: true });
    $('[data-dc-tpl="45"]').first().attr('data-sitemap-content', '');
  },
});
---
