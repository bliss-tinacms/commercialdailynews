---
import { getGlobalChrome, getUser, listBlogs } from '../../lib/data';
import { renderAuthority } from '../../lib/demo-authority';
import { mutateAuthor } from '../../lib/commercial-renderers';

export const prerender = false;
const parts = String(Astro.params.slug || '').toLowerCase().split('/').filter(Boolean);
const pageIndex = parts.indexOf('page');
const slug = (pageIndex >= 0 ? parts.slice(0, pageIndex) : parts).join('/');
const page = pageIndex >= 0 ? Math.max(1, Number(parts[pageIndex + 1]) || 1) : 1;
const perPage = 7;
const user: any = slug ? (await getUser(slug)).data?.user : null;
if (!user) return new Response('Not Found', { status: 404 });
// The supplied author authority is a seven-story newsroom ledger. Keep that
// immutable card geometry while replacing every card value with live Tina
// content. The author document remains the archive identity/editing authority.
const allPosts = await listBlogs();
const posts = allPosts.slice((page - 1) * perPage, page * perPage);
const chrome = await getGlobalChrome();
const config: any = chrome.config;
const seo = user.seo || {};
const canonical = page > 1 ? `/author/${slug}/page/${page}/` : `/author/${slug}/`;
return renderAuthority({
  family: 'author',
  chrome,
  seo: {
    title: seo.metaTitle || `${user.name} Articles | ${config?.seo?.title || 'Commercial Daily News'}`,
    description: seo.metaDescription || user.bio || '',
    canonical: seo.canonicalUrl || canonical,
    image: seo.ogImage || user.avatar,
    ogTitle: seo.ogTitle,
    ogDescription: seo.ogDescription,
    noindex: seo.noindex,
    nofollow: seo.nofollow,
  },
  mutate: ($) => mutateAuthor($, user, posts, page, allPosts.length, perPage),
});
---
