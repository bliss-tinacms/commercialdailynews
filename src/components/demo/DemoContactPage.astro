---
import { tinaField } from '@tinacms/astro/tina-field';

const { data = null, config = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const formSection = block?.formSection || {};
const inboxes = block?.inboxes || {};
const requests = block?.requests || {};
const inboxCards = Array.isArray(inboxes?.cards) && inboxes.cards.length ? inboxes.cards : [
  { title: 'The Newsroom', description: 'Story tips, correction requests, letters to the editor, contributor pitches, and other correspondence intended for the editorial team.', email: 'editorial@commercialdailynews.com', note: 'If your tip concerns a sensitive matter, please indicate at the top of your message whether you want to speak on the record, on background, or off the record. The publication honors any arrangement it accepts, but the terms must be settled before the information is conveyed.' },
  { title: 'General Inquiries', description: 'Advertising and partnership inquiries, technical issues with the site, newsletter and account questions, and general reader correspondence.', email: 'info@commercialdailynews.com', note: 'This inbox is staffed during U.S. business hours and typically responds within two business days.' },
];
const requestCards = Array.isArray(requests?.cards) && requests.cards.length ? requests.cards : [
  { title: 'Corrections', text: 'If you have identified a factual error in a published piece, send the article URL, the specific error, and the corrected information to the editorial inbox listed above.' },
  { title: 'DMCA & Legal Notices', text: 'Copyright takedown notices, counter-notifications, and other legal correspondence reach the publication through the editorial address.' },
  { title: 'Letters to the Editor', text: 'Letters written for publication as reader correspondence should be flagged as such in the subject line.' },
];
const formAction = formSection.formAction || config?.contactForm?.formspreeEndpoint || '';
const formConfigured = /^https:\/\/formspree\.io\/f\/[A-Za-z0-9_-]+$/.test(formAction);
const t = (value: unknown, fallback: string) => String(value || fallback);
---

<main class="ffn-demo ffn-demo-contact">
  <header class="ph"><div class="w"><div class="ph-in">
    <div class="ph-k"><b data-tina-field={hero ? tinaField(hero, 'eyebrow') : undefined}>{t(hero.eyebrow, 'Contact Us')}</b></div>
    <h1 data-tina-field={hero ? tinaField(hero, 'headline') : undefined}>{t(hero.headline, 'Get in Touch.')}</h1>
    <p class="ph-d" data-tina-field={hero ? tinaField(hero, 'lede') : undefined}>{t(hero.lede, 'Have a question, a story tip, or something to share? Send us a message and the right person will get back to you.')}</p>
  </div></div></header>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={formSection ? tinaField(formSection, 'eyebrow') : undefined}>{t(formSection.eyebrow, 'Send a message')}</span></div>
    <h2 class="h2" data-tina-field={formSection ? tinaField(formSection, 'title') : undefined}>{t(formSection.title, 'Write to the newsroom')}</h2>
    <p class="fm-lead">A person reads every message that arrives here.</p>
    <p class="fm-sub" data-tina-field={formSection ? tinaField(formSection, 'description') : undefined}>{t(formSection.description, 'Use this form for story tips, corrections, letters to the editor, or general questions. If your message concerns a sensitive matter, state at the top whether you are on the record, on background, or off the record — before you tell us anything.')}</p>
    <form class="fm-f" method="POST" action={formConfigured ? formAction : undefined}>
      <div class="fm-top"><span>Contact Form</span><b>Story tips · Corrections · Letters · General</b></div>
      <div class="fm-b">
        <input type="hidden" name="_subject" value={t(formSection.subject, 'Commercial Daily News contact form submission')} />
        <div class="f3">
          <div class="fr"><label class="fl" for="f-name">Full Name <b>*</b></label><input class="fi" id="f-name" name="full_name" type="text" placeholder="Your full name" required /></div>
          <div class="fr"><label class="fl" for="f-email">Email <b>*</b></label><input class="fi" id="f-email" name="email" type="email" placeholder="you@example.com" required /></div>
          <div class="fr"><label class="fl" for="f-phone">Phone</label><input class="fi" id="f-phone" name="phone" type="tel" placeholder="(000) 000-0000" /></div>
        </div>
        <div class="fr"><label class="fl" for="f-msg">Message <b>*</b></label><textarea class="fi" id="f-msg" name="message" placeholder="What happened, who is involved, and any documents you can share" required></textarea></div>
      </div>
      <div class="fm-foot">
        <p class="fn" data-tina-field={formSection ? tinaField(formSection, 'note') : undefined}>{t(formSection.note, 'Fields marked * are required. Read during U.S. business hours. Do not use a work account if your message is sensitive.')}</p>
        <button class="fb" type="submit" disabled={!formConfigured} aria-disabled={!formConfigured} data-tina-field={formSection ? tinaField(formSection, 'buttonText') : undefined}>{formConfigured ? t(formSection.buttonText, 'Send Message') : 'Configure Formspree to enable'}</button>
      </div>
    </form>
  </div></section>

  <section class="sc alt"><div class="w">
    <div class="eye"><i></i><span data-tina-field={inboxes ? tinaField(inboxes, 'eyebrow') : undefined}>{t(inboxes.eyebrow, 'Where to write')}</span></div>
    <h2 class="h2" data-tina-field={inboxes ? tinaField(inboxes, 'title') : undefined}>{t(inboxes.title, 'The two inboxes')}</h2>
    <div class="ad">
      {inboxCards.map((card: any) => (
        <article class="adi">
          <div class="adi-top"><span data-tina-field={tinaField(card, 'title')}>{card.title}</span><b>{card.title === 'The Newsroom' ? 'Monitored by the editors' : 'U.S. business hours'}</b></div>
          <div class="adi-b">
            <a class="adi-a" href={`mailto:${card.email}`} data-tina-field={tinaField(card, 'email')}>{card.email}</a>
            <p class="adi-x" data-tina-field={tinaField(card, 'description')}>{card.description}</p>
            <p class="adi-note" data-tina-field={tinaField(card, 'note')}>{card.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <section class="sc"><div class="w">
    <div class="eye"><i></i><span data-tina-field={requests ? tinaField(requests, 'eyebrow') : undefined}>{t(requests.eyebrow, 'Specific requests')}</span></div>
    <h2 class="h2" data-tina-field={requests ? tinaField(requests, 'title') : undefined}>{t(requests.title, 'How to route your message')}</h2>
    <p class="fm-sub" data-tina-field={requests ? tinaField(requests, 'intro') : undefined}>{t(requests.intro, 'Corrections, legal notices, and letters follow their own process. Flagging yours correctly gets it handled faster.')}</p>
    <div class="rt">
      {requestCards.map((card: any) => (
        <article class="rti">
          <h3 class="rti-h" data-tina-field={tinaField(card, 'title')}><i></i>{card.title}</h3>
          <p class="rti-x" data-tina-field={tinaField(card, 'text')}>{card.text}</p>
        </article>
      ))}
    </div>
  </div></section>

  <section class="cl"><div class="w"><div class="cl-in">
    <h2>Who answers for the coverage</h2>
    <p>Meet the editors responsible for the publication standards, corrections record, and daily coverage decisions.</p>
    <a class="cl-cta" href="/team/">Meet the Editors →</a>
  </div></div></section>
</main>
